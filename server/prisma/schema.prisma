// ============================================================================
// Schema Prisma — InvestSmart
// Definição do modelo de dados para o simulador académico de investimentos.
// Todos os valores são fictícios e meramente estimativos.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enumerações
// ----------------------------------------------------------------------------

/// Categorias de ativos disponíveis na plataforma
enum AssetCategory {
  STOCKS
  BONDS
  MUTUAL_FUNDS
  REAL_ESTATE
  CRYPTO
  FIXED_INCOME
}

/// Tipo de juro utilizado na simulação
enum InterestType {
  SIMPLE
  COMPOUND
}

// ----------------------------------------------------------------------------
// Modelos
// ----------------------------------------------------------------------------

/// Representa um ativo financeiro simulado na plataforma
model Asset {
  id                     String        @id @default(uuid())
  ticker                 String        @unique
  name                   String
  category               AssetCategory
  description            String?
  simulatedPrice         Decimal       @db.Decimal(12, 2)
  simulatedAnnualReturn  Decimal       @db.Decimal(5, 2)
  riskLevel              String
  isMockData             Boolean       @default(true)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  /// Relação com as simulações que incluem este ativo
  simulations SimulationAsset[]

  @@map("assets")
}

/// Representa uma simulação de investimento criada pelo utilizador
model Simulation {
  id                    String       @id @default(uuid())
  title                 String?
  initialAmount         Decimal      @db.Decimal(12, 2)
  monthlyContribution   Decimal      @default(0) @db.Decimal(12, 2)
  annualRate            Decimal      @db.Decimal(5, 2)
  periodMonths          Int
  interestType          InterestType
  finalEstimatedTotal   Decimal      @db.Decimal(14, 2)
  totalInterestEarned   Decimal      @db.Decimal(14, 2)
  isAcademicEstimate    Boolean      @default(true)
  createdAt             DateTime     @default(now())

  /// Ativos associados a esta simulação
  assets SimulationAsset[]

  @@map("simulations")
}

/// Tabela de junção entre simulações e ativos, com percentagem de alocação
model SimulationAsset {
  simulationId String
  assetId      String
  allocation   Decimal @db.Decimal(5, 2)

  /// Referência à simulação
  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  /// Referência ao ativo
  asset      Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([simulationId, assetId])
  @@map("simulation_assets")
}
