// ============================================================================
// Schema Prisma — InvestSmart
// Modelo de dados da plataforma académica de simulação de investimentos.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enumerações
// ----------------------------------------------------------------------------

/// Categorias de ativos disponíveis no catálogo.
enum AssetCategory {
  STOCKS
  BONDS
  MUTUAL_FUNDS
  REAL_ESTATE
  CRYPTO
  FIXED_INCOME
}

/// Nível de risco associado a um ativo.
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum InterestType {
  SIMPLE
  COMPOUND
}

enum CompoundingFrequency {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

// ----------------------------------------------------------------------------
// Modelos
// ----------------------------------------------------------------------------

/// Ativo financeiro fictício apresentado no catálogo.
model Asset {
  id                  String        @id @default(uuid()) @db.Uuid
  name                String        @unique
  category            AssetCategory
  description         String        @db.Text
  estimatedAnnualRate Decimal       @db.Decimal(6, 2)
  riskLevel           RiskLevel
  currency            String        @default("AOA") @db.VarChar(3)
  createdAt           DateTime      @default(now())

  /// Simulações realizadas com este ativo.
  simulations Simulation[]

  @@index([category])
  @@index([riskLevel])
  @@map("assets")
}

/// Simulação de investimento guardada pelo utilizador.
model Simulation {
  id             String   @id @default(uuid()) @db.Uuid
  initialCapital Decimal  @db.Decimal(14, 2)
  /// Duração da simulação em meses.
  duration       Int
  /// Taxa de juro anual em percentagem (ex.: 9.50 para 9,5%).
  interestRate   Decimal  @db.Decimal(6, 2)
  interestType   InterestType @default(COMPOUND)
  compoundingFrequency CompoundingFrequency @default(MONTHLY)
  /// Montante final calculado pelo backend.
  finalAmount    Decimal  @db.Decimal(16, 2)
  /// Lucro calculado pelo backend (finalAmount - initialCapital).
  profit         Decimal  @db.Decimal(16, 2)
  assetId        String   @db.Uuid
  createdAt      DateTime @default(now())

  /// Ativo associado à simulação.
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([assetId])
  @@index([createdAt])
  @@map("simulations")
}
