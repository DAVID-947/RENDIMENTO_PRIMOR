# ============================================
# InvestSmart — Variáveis de Ambiente
# ============================================
# O backend lê backend/.env. Este ficheiro serve de referência
# para a configuração global do repositório.

# Base de Dados PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/investsmart?schema=public"

# Servidor
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Cliente
VITE_API_BASE_URL=http://localhost:3001/api
