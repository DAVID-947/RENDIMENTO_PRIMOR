# ============================================
# Rendimento Primor — Variáveis de Ambiente
# ============================================
# O backend lê backend/.env. Este ficheiro serve de referência
# para a configuração global do repositório.

# Base de Dados PostgreSQL
DATABASE_URL="postgresql://investsmart:CHANGE_ME@localhost:5433/investsmart?schema=public"
POSTGRES_DB=investsmart
POSTGRES_USER=investsmart
POSTGRES_PASSWORD=CHANGE_ME

# Servidor
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Cliente
VITE_API_BASE_URL=http://localhost:3001/api
